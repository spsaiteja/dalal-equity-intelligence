# DalalAI Environment Configuration Template
# Copy this file to .env.local and populate the values for production or web hosting.

# ==============================================================================
# 1. Google Gemini AI Key (Shared Server-Side Key)
# ==============================================================================
# Get your free key from: https://aistudio.google.com/app/apikey
# This key is kept strictly server-side and protected by the login gatekeeper.
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# 2. Master Admin Email & Access Management (Zero DB Whitelist)
# ==============================================================================
# Master administrator email with permanent terminal access and approval privileges.
ADMIN_EMAIL=teja.sai42@gmail.com

# Comma-separated list of pre-approved email addresses (Optional)
ALLOWED_EMAILS=teja.sai42@gmail.com,co-investor@gmail.com

# 32+ character random secret string used to sign HMAC SHA-256 session cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=generate_a_random_32_character_secret_here

# ==============================================================================
# 3. Google OAuth 2.0 Credentials (For Web Hosting)
# ==============================================================================
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web Application)
# 3. Authorized Redirect URI:
#    - Local: http://localhost:3000/api/auth/google/callback
#    - Production: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================================================
# 4. Upstox Demat Integration (Per-User Browser Isolated)
# ==============================================================================
# Users can enter their 1-Year Analytics Access Token or OAuth credentials directly
# in the in-app Settings modal. The token is securely stored in their own browser.
# (Optional server-wide fallback for single-tenant local dev):
# UPSTOX_API_KEY=your_upstox_api_key
# UPSTOX_API_SECRET=your_upstox_api_secret
