# DalalAI Environment Configuration Template
# Copy this file to .env.local and insert your free Gemini key.

# Google Gemini AI API Key
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Upstox credentials can be entered in the terminal UI (Settings -> Upstox Brokerage)
# Or optionally specified here:
# UPSTOX_API_KEY=your_upstox_api_key
# UPSTOX_API_SECRET=your_upstox_api_secret

